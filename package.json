{
    "name": "n8n-nodes-crossmint",
    "version": "1.1.0",
    "description": "Crossmint n8n node",
    "license": "MIT",
    "homepage": "https://docs.crossmint.com/solutions/n8n/overview",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "Crossmint",
        "email": "support@crossmint.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/crossmint/n8n-nodes-crossmint.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "credentials": [
            "dist/credentials/CrossmintApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/CrossmintWallets/CrossmintWallets.node.js",
            "dist/nodes/CrossmintCheckout/CrossmintCheckout.node.js",
            "dist/nodes/CrossmintCheckout/CrossmintCheckoutTrigger.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "@types/express": "^5.0.3",
        "@types/node": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    },
    "overrides": {
        "@isaacs/brace-expansion": "5.0.1",
        "basic-ftp": "5.3.1",
        "defu": "6.1.5",
        "eslint-plugin-n8n-nodes-base": {
            "minimatch": "9.0.7"
        },
        "flatted": "3.4.2",
        "form-data": "4.0.5",
        "handlebars": "4.7.9",
        "lodash": "4.18.1",
        "undici": "6.24.0"
    }
}
